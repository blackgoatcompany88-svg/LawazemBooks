{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/school-books exec expo export --platform web",
  "outputDirectory": "artifacts/school-books/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
